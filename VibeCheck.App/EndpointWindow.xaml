<Window x:Class="VibeCheck.App.EndpointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Deep pass endpoint"
        Width="600"
        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}"
        WindowStyle="None" AllowsTransparency="False">

    <!-- Sized to its content for the same reason as the key dialog: the paragraphs wrap to a
         different number of lines depending on font and DPI, so any fixed height is a guess
         that is wrong on somebody's machine. -->
    <Window.SizeToContent>Height</Window.SizeToContent>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Deep pass endpoint" FontWeight="SemiBold"
                           Margin="14,0" VerticalAlignment="Center"/>

                <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="OnCancel"/>
            </Grid>
        </Border>

        <!-- Scrolls, because this window sizes to its content and the content now includes a
             detection panel whose height depends on how many models the reader happens to have
             installed. Without this the buttons leave the bottom of the screen on a short
             display, which is the same failure the waiting screen had. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Answer the deep pass with another model" Style="{StaticResource Heading}"/>

            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Anything that speaks the OpenAI chat-completions shape can read the files, which covers every hosted provider worth naming and Ollama or LM Studio on this machine. A local model is the only route where the files never leave this computer at all."/>

            <!-- ============ This machine ============
                 Detected and then handed back for correction. The figure decides which model is
                 worth running, detection is wrong on any laptop with two adapters, and a number
                 the reader cannot argue with is just a guess wearing a uniform. -->
            <TextBlock Text="This machine" Style="{StaticResource Heading}"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="AdapterName" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Text="Looking..."/>
                <TextBlock Text="Video memory:" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBox x:Name="VideoMemoryBox" Width="56" Height="26" Margin="6,0,0,0"
                         TextAlignment="Center" TextChanged="OnVideoMemoryChanged"/>
                <TextBlock Text="GB" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock x:Name="MemorySource" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="HardwareAdvice" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- ============ What is already running ============ -->
            <TextBlock x:Name="DetectionStatus" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Looking for Ollama and LM Studio on this machine..."/>

            <ItemsControl x:Name="DetectedModels" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Wrapping content with a ceiling, rather than a plain string. The
                             label carries a name, a size and a verdict, and two runtimes running
                             at once prefix it with a third thing; on one line that runs off the
                             right edge of the dialog and the verdict is the part that is lost. -->
                        <Button Style="{StaticResource Btn}" MaxWidth="536"
                                Margin="0,0,0,6" HorizontalAlignment="Left"
                                Click="OnUseDetected">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The one step this application cannot take for the reader, given to them as the
                 exact line to run rather than as a description of it. -->
            <StackPanel x:Name="PullRow" Orientation="Horizontal" Margin="0,4,0,0"
                        Visibility="Collapsed">
                <TextBox x:Name="PullCommand" IsReadOnly="True" Height="26" Width="280"/>
                <Button Content="Copy" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        Click="OnCopyPull"/>
                <!-- Beside the command rather than inside it. The size belongs next to the model
                     name, where somebody reading the recommendation decides whether to take it,
                     but the box is copied verbatim to the clipboard and a size appended to the
                     text would travel with it and stop being a runnable command. -->
                <TextBlock x:Name="PullSize" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="ContextCaution" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"
                       Text="One thing to check: the deep pass sends whole files, several times larger than Ollama's traditional default context of 4096 tokens. If yours is still on that default, most of each file is dropped before the model reads it and the scan will look quiet rather than broken. Setting OLLAMA_CONTEXT_LENGTH to 32768 removes the doubt."/>

            <Border Height="1" Background="{StaticResource Edge}" Margin="0,16,0,14"/>

            <!-- Buttons rather than a drop-down. Every option is visible without a click, which
                 is the point: the reason this list exists is that nobody remembers Ollama's port
                 or that OpenRouter serves from /api/v1, and a closed list hides exactly the
                 thing that was hard to remember. -->
            <TextBlock Style="{StaticResource Caption}" Text="Start from"/>

            <ItemsControl x:Name="PresetList" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Style="{StaticResource Btn}"
                                Margin="0,0,8,8" Click="OnPreset"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Endpoint" Margin="0,10,0,4"/>
            <TextBox x:Name="UrlBox" Height="30" LostFocus="OnUrlLostFocus"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="A base URL is completed to the chat-completions path when you leave the field, so this box always shows the exact address the files will be sent to. https is required unless the model is on this machine."/>

            <TextBlock Text="Model" Margin="0,14,0,4"/>
            <TextBox x:Name="ModelBox" Height="30"/>
            <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="The model id exactly as the provider writes it. A request has to name one, and there is no default that would be right for both a local runtime and a hosted provider."/>

            <TextBlock Text="Key" Margin="0,14,0,4"/>
            <PasswordBox x:Name="KeyBox" Height="30"/>
            <TextBlock x:Name="KeyNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="Left empty for a model on this machine, which has nothing to authenticate. Sent as a bearer token, encrypted to your Windows account, and stored outside this application's folder."/>

            <!-- Only when there is one to forget. A key already stored cannot be shown back, so
                 an empty box has to mean "keep it", and this is the only way to say otherwise
                 without offering to display a credential. -->
            <CheckBox x:Name="ForgetKey" Content="Forget the stored key" Margin="0,8,0,0"
                      Visibility="Collapsed"/>

            <TextBlock x:Name="Problem" TextWrapping="Wrap" Margin="0,14,0,0"
                       Foreground="{StaticResource Critical}" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="RemoveButton" Content="Remove endpoint" Style="{StaticResource Btn}"
                        Click="OnRemove"/>
                <!-- IsCancel so Escape still closes it: replacing the system title bar took away
                     the usual way out of a dialog. -->
                <Button Content="Cancel" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="Save" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        Click="OnSave" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
