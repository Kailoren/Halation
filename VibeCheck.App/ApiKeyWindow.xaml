<Window x:Class="VibeCheck.App.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep pass API key"
        Height="300" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="Anthropic API key" Style="{StaticResource Heading}"/>

        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="The deep pass runs on your own account. Create a key at console.anthropic.com and paste it below. It is encrypted to your Windows account and stored outside this application's folder."/>

        <!-- PasswordBox, not TextBox: the key should not be readable over a shoulder or in a
             screenshot, and it is never displayed again once stored. -->
        <PasswordBox x:Name="KeyBox" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                     Background="{StaticResource PanelRaised}"
                     Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Edge}" BorderThickness="1"
                     FontFamily="Consolas"/>

        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Only the files selected by triage are sent, and only on scans where you tick the deep pass box. Nothing is sent on an isolated scan. Leave the box empty and save to remove a stored key."/>

        <TextBlock x:Name="CostNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Typical cost is a few cents per scan, billed to you by Anthropic. The report states what was spent."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Remove key" Style="{StaticResource Btn}" Click="OnRemove"/>
            <Button Content="Cancel" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnCancel"/>
            <Button Content="Save" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
