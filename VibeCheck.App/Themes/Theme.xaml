<!--
    VibeCheck default theme.

    Every colour, font and metric the interface uses is a named key in here. Nothing visual
    should be hardcoded in a window: if a value cannot be changed from this file, that is a
    bug in the theme rather than a preference of the window.

    That principle used to stop at colour. A theme could recolour the interface but not
    restyle it, because the shape of a card and the way a button responds to a pointer lived
    inside the window's markup where nothing could reach them. Both now live here, as
    templates, and the window holds only arrangement. A theme that wants notched corners, a
    glow, or a slower hover overrides a template rather than asking for a code change.

    To experiment without rebuilding, copy this file to

        %LOCALAPPDATA%\VibeCheck\theme.xaml

    and edit it there. It is merged over this one at startup, so it only needs to contain the
    keys being changed. Delete that file to go back to what is in here. A theme that fails to
    parse is reported once and ignored, so a bad edit cannot stop the application starting.

    See THEME.md beside this file for what each key controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         Palette

         Deliberately neutral: this is a security tool, and a result should read as evidence
         rather than as branding. The severity colours are the only saturated ones in the
         application, so they carry meaning by contrast rather than by decoration. Changing
         the neutrals is safe; changing the severity ramp changes what a glance communicates.
         ==================================================================== -->


    <SolidColorBrush x:Key="Bg"          Color="#16181D"/>
    <SolidColorBrush x:Key="Panel"       Color="#1E2128"/>
    <SolidColorBrush x:Key="PanelRaised" Color="#252932"/>
    <SolidColorBrush x:Key="Edge"        Color="#2E323B"/>
    <SolidColorBrush x:Key="Text"        Color="#E4E7EC"/>
    <SolidColorBrush x:Key="Muted"       Color="#8B93A1"/>
    <SolidColorBrush x:Key="Accent"      Color="#4C8DFF"/>

    <!-- Was hardcoded inside two control templates, which made hover the one thing a theme
         could not touch. -->
    <SolidColorBrush x:Key="Hover"       Color="#2F3540"/>
    <SolidColorBrush x:Key="CloseHover"  Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnDanger"    Color="#FFFFFF"/>

    <!-- The accent at low alpha, for a surface that is being pointed at or dragged onto rather
         than merely hovered. Translucent on purpose: it is laid over whatever it highlights, so
         one key covers every such surface whatever colour that surface happens to be, and every
         one of them is then the same colour as the others by construction rather than because
         somebody copied a hex value. -->
    <SolidColorBrush x:Key="AccentWash"  Color="#1F4C8DFF"/>

    <!-- Severity ramp. Read left to right as worsening; keep them distinguishable to a
         colour-blind reader by lightness as well as by hue. -->
    <SolidColorBrush x:Key="Critical" Color="#FF4D4F"/>
    <SolidColorBrush x:Key="High"     Color="#FF8A3D"/>
    <SolidColorBrush x:Key="Medium"   Color="#FFC53D"/>
    <SolidColorBrush x:Key="Low"      Color="#58B2FF"/>
    <SolidColorBrush x:Key="Good"     Color="#52C41A"/>

    <!-- "Could not analyse" is grey, never green. An artifact that was never read must not
         look like one that passed, and keeping those visually distinct is the entire point of
         having the band. If a theme makes this green, the theme is lying for the tool. -->
    <SolidColorBrush x:Key="Unknown" Color="#6B7280"/>

    <!-- Filled panels that belong to a severity: the do-not-install banner and the note that
         marks a finding as inferred by the deep pass. Both were hardcoded browns in the window
         markup, which made the two loudest surfaces in the application the two a theme could
         not touch.

         Opaque rather than a wash, unlike AccentWash. These are not laid over something to
         tint it, they are the surface, and they are dark enough that the severity they belong
         to has to be readable against them. A theme is free to make them translucent; the
         default does not, because these two values were chosen against the default background
         and picking them apart into a tint would change how they look for no gain. -->
    <SolidColorBrush x:Key="CriticalFill" Color="#2A1618"/>
    <SolidColorBrush x:Key="MediumFill"   Color="#2A2418"/>

    <!-- ====================================================================
         Typography and metrics
         ==================================================================== -->

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <!-- Headings, the app name and the score. Separate from UiFont because display faces are
         usually wide and unreadable at body size, so a theme wanting one needs somewhere to
         put it that is not the paragraph text. Defaults to UiFont's face, meaning a theme that
         ignores this key looks exactly as it did. -->
    <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>

    <!-- Segoe MDL2 Assets supplies the title bar glyphs. Replacing it means replacing the
         glyph codes in the window markup too. -->
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="BodySize">13</sys:Double>
    <sys:Double x:Key="CaptionSize">12</sys:Double>
    <sys:Double x:Key="HeadingSize">15</sys:Double>
    <sys:Double x:Key="ScoreSize">42</sys:Double>

    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">4</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ButtonPadding">14,7</Thickness>
    <sys:Double x:Key="CaptionHeight">36</sys:Double>

    <!-- ====================================================================
         Motion

         Durations rather than storyboards, because a storyboard cannot usefully be swapped by
         key: the animations below live inside control templates and name the elements they
         move, so a replacement would have to know those names anyway. A theme that only wants
         the interface to feel faster or calmer changes these two numbers; a theme that wants
         different motion overrides the template, which is where motion belongs.

         The templates below reach these with StaticResource on purpose. Timelines are
         Freezables rather than framework elements, and DynamicResource has no element tree to
         walk from inside one, so it silently resolves to nothing. StaticResource within this
         same dictionary is resolved at load and works. The consequence is the same one that
         BasedOn has further down: overriding SwiftDuration alone does not reach these
         templates, and a theme that wants different timing overrides the template too.

         Everything here animates Opacity or RenderTransform, and nothing else. Those are
         plain dependency properties on framework elements, so they compose, they do not
         invalidate layout, and they cannot hit the "cannot animate on an immutable object"
         wall that catches anyone trying to animate a brush or an effect directly. A theme
         adding motion should stay inside that rule: fade a dedicated layer in and out rather
         than animating the thing it decorates.
         ==================================================================== -->

    <Duration x:Key="SwiftDuration">0:0:0.13</Duration>
    <Duration x:Key="CalmDuration">0:0:0.30</Duration>

    <!-- ====================================================================
         Decoration slots

         Empty here, and that is the point. Each is a template the window mounts but the
         default theme declines to fill, so the neutral look costs nothing and a theme can add
         atmosphere without the window growing a single element on its behalf. All of them are
         mounted behind IsHitTestVisible="False", so whatever a theme puts in one can never
         swallow a click.

         The glow slots are x:Null rather than absent so that the key exists to be found and
         to be documented. Effect="{DynamicResource CardGlow}" against a missing key is legal
         and does nothing, which is the same result by accident instead of on purpose.
         ==================================================================== -->

    <!-- Behind everything, above the window background. For gradients, grain, scanlines,
         anything that should sit under the entire interface. -->
    <ControlTemplate x:Key="WindowBackdrop" TargetType="ContentControl"/>

    <!-- In front of everything. For vignettes, CRT curvature, glass. Keep it faint: this
         layer covers the findings, and the findings are the product. -->
    <ControlTemplate x:Key="WindowOverlay" TargetType="ContentControl"/>

    <!-- Inside every card, between its border and its content. For corner cuts and ticks. -->
    <ControlTemplate x:Key="CardChrome" TargetType="ContentControl"/>

    <!-- Effects, applied to the border elements alone rather than to whole controls. An Effect
         rasterises the subtree it is set on, so putting one on a card would push every
         paragraph inside it through the same intermediate surface and cost the text its
         subpixel antialiasing. The templates below keep each border as an empty sibling of the
         content for exactly this reason: the glow is free to be expensive because nothing
         readable is inside it. -->
    <x:Null x:Key="CardGlow"/>
    <x:Null x:Key="ButtonGlow"/>
    <x:Null x:Key="DropZoneGlow"/>

    <!-- ====================================================================
         Control styles
         ==================================================================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource HeadingSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
    </Style>

    <!-- Cards.

         A ContentControl rather than a Border, which is the change that makes a card a shape a
         theme owns instead of a rectangle the window draws. A Border has exactly one child and
         no template, so the only thing a style could say about it was what colour it was; a
         templated control can be given corner cuts, a glow, an overlay and a different
         arrangement entirely without any of the twelve call sites knowing.

         The border is an empty sibling of the content rather than its parent. That is what
         lets CardGlow be a real effect without dragging every paragraph in the card through
         the rasteriser with it. -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>

        <!-- Set rather than left to the default, because a Border stretched its child and a
             ContentControl does not have to. Without these the twelve cards this replaced
             would all shrink to their content's width. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardRadius}"
                                Effect="{DynamicResource CardGlow}"/>

                        <ContentControl Template="{DynamicResource CardChrome}"
                                        IsHitTestVisible="False"/>

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drop zone, which is the first thing anyone sees and the only element in the
         application worth decorating on its own. Templated for the same reason cards are, and
         separately from them because it is the one card-like thing that reacts: the drag state
         is a real state and a theme should be able to make it feel like one. -->
    <Style x:Key="DropZone" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>

                        <!-- The drag state as its own layer, faded rather than switched. A
                             Setter swapping BorderBrush snaps, and a brush cannot be animated
                             in place once WPF has frozen it, so the accent border is a second
                             element sitting exactly on the first with its opacity animated. -->
                        <Border x:Name="Active" Opacity="0" CornerRadius="10"
                                Background="{DynamicResource Hover}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Effect="{DynamicResource DropZoneGlow}"/>

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonRadius}"/>

                        <!-- Hover as a layer to cross-fade to, for the same reason the drop
                             zone has one: this used to be two Setters and it snapped. -->
                        <Border x:Name="Hot" Opacity="0"
                                Background="{DynamicResource Hover}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonRadius}"
                                Effect="{DynamicResource ButtonGlow}"/>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two audience choices, which are buttons the size of paragraphs rather than
         buttons the size of words.

         They had no style at all until now, which meant they fell through to WPF's stock
         Button template and lit up in the Aero2 mouse-over blue. That blue is baked into the
         framework's own theme dictionary, so it was the one colour in the application that no
         theme could reach and no palette could explain. Anything given to a user to click
         needs a style here, even when the default happens to look acceptable.

         Borderless at rest so the choices read as part of the card they sit in, with the whole
         frame arriving on hover. AccentWash rather than Hover for the fill: this is a
         selection, and it should look like the drop zone accepting a file rather than like a
         toolbar button being passed over. -->
    <Style x:Key="ChoiceBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ButtonRadius}"/>

                        <!-- Thickness fixed rather than template-bound, because the control is
                             borderless at rest and binding it would leave the hover state with
                             nothing to draw. -->
                        <Border x:Name="Hot" Opacity="0"
                                Background="{DynamicResource AccentWash}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ButtonRadius}"
                                Effect="{DynamicResource ButtonGlow}"/>

                        <!-- Keyboard focus gets its own layer rather than sharing the hover
                             one. Two triggers animating a single Opacity means whichever ran
                             last owns it, and tabbing away while the pointer is still over the
                             control would clear a highlight that should have stayed. -->
                        <Border x:Name="Ring" Opacity="0"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ButtonRadius}"/>

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar buttons. Flat and borderless, and hit-test-visible so WindowChrome hands
         them clicks instead of treating them as drag surface. -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="{DynamicResource CaptionHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource Hover}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Inputs

         Both templated in full, and both for the reason that keeps recurring: WPF's stock
         templates take their colours from the framework's own theme dictionary. The focus ring
         on a PasswordBox and the hover fill on a CheckBox are the Aero2 blues, they are not
         reachable from any palette in this file, and they were the last two places a dark
         yellow application still lit up in Windows blue.

         Implicit, so the two check boxes and the one password box get them without being told,
         and so does anything added later. Neither names a colour of its own.
         ==================================================================== -->

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonRadius}"/>

                        <!-- Focus and hover get a layer each rather than sharing one. They can
                             be true at the same time, and a single layer driven by both means
                             moving the pointer away clears a ring that should have stayed for
                             as long as the caret is in the field. -->
                        <Border x:Name="Hot" Opacity="0"
                                BorderBrush="{DynamicResource Muted}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonRadius}"/>

                        <Border x:Name="Focused" Opacity="0"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonRadius}"
                                Effect="{DynamicResource ButtonGlow}"/>

                        <!-- Named by contract, not by choice: PasswordBox finds where to draw
                             its content by looking for PART_ContentHost and shows nothing at
                             all without it. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent rather than unset, so the whole row including the gap
                         between box and label is clickable the way the stock one is. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Background="{DynamicResource PanelRaised}"
                                    BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ButtonRadius}"/>

                            <Border x:Name="Hot" Opacity="0"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Effect="{DynamicResource ButtonGlow}"/>

                            <!-- Stretch="None" on purpose: a stretched Path scales its stroke
                                 with the geometry, so a tick drawn to fit would come out
                                 thicker on one axis than the other. -->
                            <Path x:Name="Tick" Opacity="0"
                                  Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 0,4 L 3,7 L 9,0"/>
                        </Grid>

                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Scroll bars

         Templated in full because WPF's stock scroll bar has no seam worth using: its colours
         come from the framework's own theme dictionary, the same place the Aero2 button blue
         lives, so no palette here could reach it. A native light grey bar down the side of a
         dark window was the most visible unthemed thing left in the application.

         The style is implicit, so every ScrollViewer in every window picks it up without being
         told. It carries no colours of its own, only Muted and Accent at graded opacities, so a
         theme that never mentions scroll bars still gets one that matches it.
         ==================================================================== -->

    <!-- The page-up and page-down halves of the track. Invisible but not absent: a Rectangle
         filled with Transparent still takes a hit, which is what makes clicking the empty track
         page the view. Fill="{x:Null}" would look identical and do nothing. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setters rather than storyboards, and deliberately so. An animation outranks a Setter
         for the rest of the element's life, so a faded hover and a Setter-driven drag state on
         one property means the drag colour never appears after the first hover. The rule in the
         motion section stands: animate a layer, or do not animate. A scroll bar does not need
         it enough to earn a second layer. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2"
                            Background="{DynamicResource Muted}" Opacity="0.30"
                            CornerRadius="{DynamicResource ButtonRadius}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.60"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- PART_Track is not a name, it is the contract: ScrollBar finds its
                             track by that string and silently does nothing without it.
                             Reversed because a vertical track's zero is at the top. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- Orientation is a property rather than a separate control, so the horizontal bar
                 needs its own template. Width has to be released back to Auto or a horizontal
                 bar sits eleven pixels wide in the corner. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}"
                                                      Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}"
                                                      Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- BasedOn is the one reference here that must stay static: WPF resolves style
         inheritance when the dictionary loads and throws outright on a DynamicResource.
         It means overriding CaptionBtn alone does not reach CloseBtn, so a theme that
         restyles one should restyle both. -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource CloseHover}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{StaticResource SwiftDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource CalmDuration}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
