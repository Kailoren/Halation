<Application x:Class="VibeCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:VibeCheck.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette. Deliberately neutral: this is a security tool, and a result should read
             as evidence rather than as branding. Severity colours are the only saturated ones
             in the application, so they carry meaning by contrast rather than by decoration. -->
        <SolidColorBrush x:Key="Bg"          Color="#16181D"/>
        <SolidColorBrush x:Key="Panel"       Color="#1E2128"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#252932"/>
        <SolidColorBrush x:Key="Edge"        Color="#2E323B"/>
        <SolidColorBrush x:Key="Text"        Color="#E4E7EC"/>
        <SolidColorBrush x:Key="Muted"       Color="#8B93A1"/>
        <SolidColorBrush x:Key="Accent"      Color="#4C8DFF"/>

        <SolidColorBrush x:Key="Critical" Color="#FF4D4F"/>
        <SolidColorBrush x:Key="High"     Color="#FF8A3D"/>
        <SolidColorBrush x:Key="Medium"   Color="#FFC53D"/>
        <SolidColorBrush x:Key="Low"      Color="#58B2FF"/>
        <SolidColorBrush x:Key="Good"     Color="#52C41A"/>

        <!-- "Could not analyse" is grey, never green. An artifact that was never read must
             not look like one that passed; keeping those visually distinct is the entire
             point of having the band. -->
        <SolidColorBrush x:Key="Unknown" Color="#6B7280"/>

        <app:SeverityBrushConverter x:Key="SeverityBrush"/>
        <app:BandBrushConverter x:Key="BandBrush"/>
        <app:BoolToVisibility x:Key="BoolToVisibility"/>
        <app:InverseBoolToVisibility x:Key="InverseBoolToVisibility"/>
        <app:NullToVisibility x:Key="NullToVisibility"/>
        <app:CountToVisibility x:Key="CountToVisibility"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3540"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title-bar buttons. Flat and borderless, and hit-test-visible so WindowChrome
             hands them clicks instead of treating them as drag surface. -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3540"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
