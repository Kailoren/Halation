<Window x:Class="VibeCheck.App.ScanSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Before the scan"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}"
        WindowStyle="None" AllowsTransparency="False">

    <!-- Sized to content, as the other dialogs are: the paragraphs wrap to a different number of
         lines depending on font and DPI, so any fixed height is wrong on somebody's machine. -->
    <Window.SizeToContent>Height</Window.SizeToContent>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Before the scan" FontWeight="SemiBold"
                           Margin="14,0" VerticalAlignment="Center"/>

                <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="OnChooseDifferent"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <TextBlock x:Name="ArtifactName" Style="{StaticResource Heading}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="ReadyNote" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock x:Name="KindPrompt" FontWeight="SemiBold"/>

                <TextBlock x:Name="KindNote" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,4,0,10"/>

                <!-- Radio buttons rather than a drop-down, on the same reasoning as the endpoint
                     presets: every option visible without a click. A ComboBox would also be the
                     fifth stock control with no style in the theme, falling through to Aero2. -->
                <ItemsControl x:Name="Kinds">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Label}"
                                         GroupName="ApplicationKind"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Margin="0,0,0,7"
                                         Foreground="{StaticResource Text}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Nothing you pick here excuses anything on its own. A capability is only ever accounted for by answering the question about that specific behaviour after the scan, and the report says who said so."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <!-- IsCancel so Escape still works: replacing the system title bar took away
                         the usual way out of a dialog. -->
                    <Button Content="Choose a different file" Style="{StaticResource Btn}"
                            IsCancel="True" Click="OnChooseDifferent"/>
                    <Button Content="Start scan" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Click="OnStart" IsDefault="True"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
