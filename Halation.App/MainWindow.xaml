<Window x:Class="VibeCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:VibeCheck.App"
        mc:Ignorable="d"
        Title="VibeCheck"
        Icon="/Halation;component/Halation.ico"
        Height="820" Width="1120" MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <!-- Same chrome arrangement as the sibling applications: WindowChrome keeps the native
         resize border, Aero snap and drop shadow, while handing the top strip to our own
         content. Only the caption buttons are hit-test-visible, so everything else in that
         strip is drag-to-move and double-click-to-maximise for free. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- The top row holds the title bar and, when there is one to show, the update strip
             underneath it. Auto rather than a fixed 36 so the strip can appear and disappear
             without the caption area moving: the title bar keeps its own explicit height, which
             is the number WindowChrome above was given for the drag region. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

            <!-- The status bar. Closes the window at the bottom the way the title bar does at
                 the top: without it the content simply stopped and the near-black background
                 ran to the edge of the screen, so on a dark desktop there was nothing to say
                 where the window ended. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Theme decoration ============
             Two empty layers the theme owns: one behind the interface and one in front of it.
             The default theme leaves both blank, so this costs a pair of contentless controls
             and nothing else. They exist so that a theme wanting atmosphere has somewhere to
             put it other than in here: this file should describe what the window says, and a
             gradient sweep is not something the window has an opinion about.

             Neither is hit-testable, so nothing a theme adds can intercept a drop or swallow a
             click no matter how large it draws itself. -->
        <ContentControl Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="-1"
                        Template="{DynamicResource WindowBackdrop}"
                        IsHitTestVisible="False" Focusable="False"/>

        <StackPanel Grid.Row="0">

        <!-- ============ Title bar ============ -->
        <Border Height="36" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <!-- The .ico rather than a single bitmap, so WPF picks the frame nearest
                         the rendered size. At 20 pixels that is the cropped shield, which is
                         the whole reason the icon carries more than one image.

                         Assembly-qualified rather than "/Halation.ico": a bare relative pack
                         URI resolves against the entry assembly, so this threw the moment
                         anything other than Halation.exe hosted the window. -->
                    <Image Source="/Halation;component/Halation.ico" Width="20" Height="20"
                           VerticalAlignment="Center" Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="VibeCheck" FontWeight="SemiBold"
                               FontFamily="{DynamicResource DisplayFont}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                               Style="{StaticResource Caption}" Margin="7,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="security scanner for AI-generated apps"
                               Style="{StaticResource Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="OnMinimise"/>
                    <Button Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="OnMaximise"/>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ A newer build exists ============
             A strip rather than a dialog, and only ever for two things: a version this one is
             not, and an attempt to fetch it that did not work. A check that could not reach
             GitHub shows nothing at all, because being unable to ask is not news.

             Which buttons appear is the honest part. "Update and restart" is offered only when
             the download could actually be verified against the publisher who signed this
             build; when it cannot be, the strip says why in the line underneath and offers the
             release page instead. See UpdateInstall.Assess. -->
        <Border Background="{StaticResource PanelRaised}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding Update.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="{DynamicResource IconFont}"
                           FontSize="15" VerticalAlignment="Center"
                           Foreground="{StaticResource Accent}"
                           Visibility="{Binding Update.IsFailure,
                                        Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}"
                           FontSize="15" VerticalAlignment="Center"
                           Foreground="{StaticResource High}"
                           Visibility="{Binding Update.IsFailure,
                                        Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Update.Headline}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Update.Detail}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <ProgressBar Height="4" Margin="0,8,0,2" Minimum="0" Maximum="100"
                                 Value="{Binding Update.Progress, Mode=OneWay}"
                                 Background="{StaticResource Panel}"
                                 Foreground="{StaticResource Accent}" BorderThickness="0"
                                 Visibility="{Binding Update.ShowProgress,
                                              Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Update and restart" Style="{StaticResource Btn}"
                            Command="{Binding Update.InstallCommand}"
                            Visibility="{Binding Update.ShowInstall,
                                         Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{Binding Update.ReleasePageLabel}" Style="{StaticResource Btn}"
                            Margin="8,0,0,0"
                            Command="{Binding Update.OpenReleasePageCommand}"
                            Visibility="{Binding Update.ShowReleasePage,
                                         Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Cancel" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Command="{Binding Update.CancelCommand}"
                            Visibility="{Binding Update.IsWorking,
                                         Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="Later" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Command="{Binding Update.DismissCommand}"
                            Visibility="{Binding Update.ShowDismiss,
                                         Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        </StackPanel>

        <!-- ============ Who is reading ============
             Asked once, before any scan. The answer changes which question the score answers,
             not merely how the findings are worded, so there is no useful scan to offer until
             it has been given. -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsChoosingAudience, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">

                <TextBlock Text="Who is this for?" FontSize="26" FontWeight="Light"
                           FontFamily="{DynamicResource DisplayFont}"
                           HorizontalAlignment="Center"/>

                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="The same application is a different risk depending on whether you wrote it or downloaded it, so VibeCheck answers a different question for each. Asked every time, because the answer belongs to what you are about to check rather than to you. You can change it during a scan too."/>

                <ContentControl Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <Button Command="{Binding ChooseAudienceCommand}"
                                CommandParameter="Developer"
                                Style="{StaticResource ChoiceBtn}">
                            <StackPanel>
                                <TextBlock Text="I built this application" FontSize="15"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="Everything, including leaked keys and packaging mistakes, with rule identifiers, advisory links, and how to fix each one."/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ChooseAudienceCommand}"
                                CommandParameter="EndUser" Margin="0,10,0,0"
                                Style="{StaticResource ChoiceBtn}">
                            <StackPanel>
                                <TextBlock Text="I downloaded this application" FontSize="15"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="What it could do to you and your machine, in plain language. The developer's own mistakes are still listed, marked as not your problem."/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>

        <!-- ============ Waiting ============ -->
        <!-- Scrolls, because this screen is taller than the window's own minimum height and
             a StackPanel given less room than it needs does not clip visibly or offer a bar.
             It simply draws past the edge, so the deep pass settings and the privacy line
             underneath them become unreachable rather than merely awkward. VerticalAlignment
             stays on the inner panel so a roomy window still centres the content instead of
             pinning it to the top. -->
        <Grid Grid.Row="1" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
          <ScrollViewer x:Name="WaitingScroll" VerticalScrollBarVisibility="Auto" Padding="0,12">
            <!-- Tracking the viewport height is what keeps both behaviours: a ScrollViewer
                 hands its content unlimited height, so a centred panel inside one would sit
                 at the top forever. With this the panel centres while it fits and scrolls
                 once it does not. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=WaitingScroll}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">

                <!-- The drag state lives in the DropZone template rather than here. It used to
                     be an inline Style with a DataTrigger swapping two brushes, which meant the
                     one moment in the application with any drama in it snapped between two
                     flat colours and no theme could say otherwise. -->
                <!-- MinHeight, not Height. Fixed at 230 the zone kept its size when the selected
                     state added the kind selector, so the icon was clipped off the top and the
                     buttons rendered through the notched bottom border. The empty state still
                     wants the height, hence a floor rather than nothing. -->
                <ContentControl x:Name="DropTarget" Style="{StaticResource DropZone}" MinHeight="230">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Nothing chosen yet. -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection,
                                                         Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFont}" FontSize="40"
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop an application here"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="19" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" TextAlignment="Center"
                                       Text="An executable, an installed folder, a zip, or a source project"/>
                            <!-- Two buttons, not one that shows the folder picker and reaches
                                 the file picker only when cancelled. Windows has no dialog that
                                 takes either, so the honest arrangement is to ask which rather
                                 than make somebody dismiss the wrong one first. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,20,0,0">
                                <Button Content="Choose a file" Style="{StaticResource Btn}"
                                        Click="OnBrowseFile"/>
                                <Button Content="Choose a folder" Style="{StaticResource Btn}"
                                        Margin="10,0,0,0" Click="OnBrowseFolder"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Chosen, and waiting to be told to go. The settings below apply to
                             this scan, and this is the gap in which they can still be changed;
                             dropping a file used to start the scan before they could be read. -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection,
                                                         Converter={StaticResource BoolToVisibility}}">
                            <!-- The same glyph as the empty state, in the accent rather than the
                                 muted brush. E8A5 was tried first and rendered as an empty box:
                                 not every code point in the icon font is present, and the only
                                 way to know is to look at it. -->
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedName}" TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource DisplayFont}" MaxWidth="520"
                                       FontSize="18" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" TextAlignment="Center"
                                       Text="Ready to scan."/>
                            <!-- The buttons and the kind selector moved into ScanSetupWindow,
                                 which opens the moment something is chosen. This panel is
                                 what sits behind that dialog, so it names the artifact and
                                 stops there. -->
                        </StackPanel>

                    </Grid>
                </ContentControl>


                <!-- The audience card that used to sit here is gone. It offered a one-click
                     toggle at a point where nothing had been scanned yet, so it changed a
                     setting rather than a report, and the "return to selection" button below
                     now covers the same ground by going back to the screen that explains the
                     difference. The equivalent switch on the results screen stays: there it
                     re-answers a report already in hand, which is a different thing. -->

                <!-- Optional deep pass. Off by default and not remembered between runs: it
                     spends something of the reader's either way, so it should be a decision
                     each time. Which of the two sources answers is theirs to pick, because
                     one costs money and the other costs subscription quota. -->
                <ContentControl Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox Content="Deep pass (reads the risky files with an AI model)"
                                  IsChecked="{Binding DeepPassEnabled}"
                                  IsEnabled="{Binding CanRunDeepPass}"
                                  Foreground="{StaticResource Text}"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0"
                                   Text="Reads the files that handle untrusted input and reasons about them, catching incomplete guards and reachability that pattern rules cannot express. Findings are labelled as inferred and never trigger a do-not-install verdict."/>

                        <!-- Replaced, not disabled. A row of controls that can be clicked at
                             and does nothing is worse than no controls: it reads as broken
                             rather than as withheld, and says nothing about how to proceed. -->
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="24,10,0,0"
                                   Text="{Binding DeepPassUnavailableHere}"
                                   Visibility="{Binding DeepPassOfferedHere,
                                                Converter={StaticResource InverseBoolToVisibility}}"/>

                        <StackPanel Visibility="{Binding DeepPassOfferedHere,
                                                 Converter={StaticResource BoolToVisibility}}">

                            <!-- Outside the switch on purpose. Storing a key is configuration
                                 rather than part of this scan's choice, and putting it behind
                                 the switch would leave somebody with no key unable to reach
                                 the control that would give them one. -->
                            <StackPanel Orientation="Horizontal" Margin="24,12,0,0">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Text="Anthropic API key:"/>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" FontFamily="{DynamicResource MonoFont}"
                                           Text="{Binding ApiKeyStatus}"/>
                                <Button Content="Set key" Style="{StaticResource Btn}" Margin="12,0,0,0"
                                        Click="OnSetApiKey"/>
                            </StackPanel>

                            <!-- The third route's setup row, outside the switch for the same
                                 reason as the key: this is the control that makes the route
                                 available at all. The status names the host and the model
                                 rather than the provider, because those are the two facts that
                                 decide what happens to the files. -->
                            <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Text="Other endpoint:"/>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" FontFamily="{DynamicResource MonoFont}"
                                           Text="{Binding EndpointStatus}"/>
                                <Button Content="Configure" Style="{StaticResource Btn}" Margin="12,0,0,0"
                                        Click="OnConfigureEndpoint"/>
                            </StackPanel>

                            <!-- Beside the key row and outside the switch for the same reason:
                                 this is what makes a source available, so gating it behind the
                                 switch would strand somebody behind the control that would
                                 unlock it. Runs Claude Code's own browser sign-in, so the
                                 credential goes to its store and never through this
                                 application, which is the whole reason this route was
                                 preferred over asking for a key. -->
                            <StackPanel Orientation="Horizontal" Margin="24,8,0,0"
                                        Visibility="{Binding CanSignInToClaudeCode,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Text="Claude Code:"/>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Text="found, not signed in"/>
                                <Button Command="{Binding SignInToClaudeCodeCommand}"
                                        Content="Sign in" Style="{StaticResource Btn}"
                                        Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- What the switch above unlocks. Dimmed as a whole rather than
                                 control by control, so it reads as one thing that is off. -->
                            <StackPanel Margin="24,14,0,0" IsEnabled="{Binding DeepPassEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Each of the three explains itself on hover, in the same
                                     shape and the same order: where the code goes, what it
                                     costs, what it needs. ShowOnDisabled is not optional here.
                                     WPF suppresses tooltips on disabled controls, and a route
                                     is disabled exactly while it is unconfigured, which is the
                                     moment somebody wants to know what configuring it buys. -->
                                <RadioButton GroupName="DeepPassSource"
                                             Content="Use my Anthropic API key"
                                             IsChecked="{Binding DeepPassUsesApiKey}"
                                             IsEnabled="{Binding CanChooseApiKey}"
                                             ToolTipService.ShowOnDisabled="True"
                                             ToolTipService.ShowDuration="60000"
                                             ToolTipService.InitialShowDelay="350">
                                    <RadioButton.ToolTip>
                                        <ToolTip MaxWidth="420">
                                            <TextBlock Text="{Binding ApiKeyRouteTooltip}"
                                                       TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </RadioButton.ToolTip>
                                </RadioButton>

                                <!-- Disabled rather than hidden when unavailable: the status
                                     line underneath is the point, since every reason it is
                                     unavailable is one the reader can do something about. -->
                                <RadioButton GroupName="DeepPassSource"
                                             Content="Use Claude Code on this machine (your subscription)"
                                             IsChecked="{Binding DeepPassUsesLocalCli}"
                                             IsEnabled="{Binding CanChooseLocalCli}"
                                             Margin="0,12,0,0"
                                             ToolTipService.ShowOnDisabled="True"
                                             ToolTipService.ShowDuration="60000"
                                             ToolTipService.InitialShowDelay="350">
                                    <RadioButton.ToolTip>
                                        <ToolTip MaxWidth="420">
                                            <TextBlock Text="{Binding LocalCliRouteTooltip}"
                                                       TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </RadioButton.ToolTip>
                                </RadioButton>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="24,4,0,0" Text="{Binding LocalCliStatus}"/>

                                <!-- Last of the three because it is the one that needs setting
                                     up first, and disabled rather than hidden while nothing is
                                     configured: the row above it is what does the configuring,
                                     and an option that vanishes explains nothing. -->
                                <RadioButton GroupName="DeepPassSource"
                                             Content="Use another model (any OpenAI-compatible endpoint)"
                                             IsChecked="{Binding DeepPassUsesEndpoint}"
                                             IsEnabled="{Binding CanChooseEndpoint}"
                                             Margin="0,12,0,0"
                                             ToolTipService.ShowOnDisabled="True"
                                             ToolTipService.ShowDuration="60000"
                                             ToolTipService.InitialShowDelay="350">
                                    <RadioButton.ToolTip>
                                        <ToolTip MaxWidth="420">
                                            <TextBlock Text="{Binding EndpointRouteTooltip}"
                                                       TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </RadioButton.ToolTip>
                                </RadioButton>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="24,4,0,0" Text="{Binding EndpointSourceStatus}"/>

                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,12,0,0" Text="{Binding DeepPassCostLine}"/>
                            </StackPanel>

                            <!-- Bound, not fixed. This sentence used to state that both routes
                                 went to Anthropic, which a third route made false; a paragraph
                                 that keeps naming a destination the reader has just changed is
                                 worse than none, because there is no reason to doubt it. -->
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,10,0,0"
                                       Text="{Binding DeepPassDestinationLine}"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Margin="0,12,0,0"
                                BorderBrush="{StaticResource Critical}"
                                Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                               Foreground="{StaticResource Critical}"/>
                </ContentControl>

                <!-- Bound rather than fixed: this promise stops being true the moment the
                     deep pass is switched on, and must say so. -->
                <!-- Back to the opening question. The inline toggle above changes the reader
                     in one click, which is right when you know what you want; this is for
                     when what you actually want is the screen that explains the difference. -->
                <Button Command="{Binding ReturnToSelectionCommand}"
                        Content="Return to selection"
                        Style="{StaticResource Btn}"
                        HorizontalAlignment="Center" Margin="0,18,0,0"/>

                <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="{Binding PrivacyLine}"/>

                <!-- Beside the promise above rather than buried in a settings screen, because
                     it is the same kind of statement: this is the other connection the
                     application makes, and one that could not be turned off would be an
                     exception to a claim made in the sentence above it. -->
                <CheckBox Content="Ask GitHub for new versions when VibeCheck starts"
                          IsChecked="{Binding Update.CheckOnStartup}"
                          Foreground="{StaticResource Muted}"
                          FontSize="{DynamicResource CaptionSize}"
                          HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="A request for the public release list, and nothing about you or this machine. Which version is newer is worked out here."/>
            </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- ============ Scanning ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <!-- Wrapped rather than left on one line: this message carries a file path
                     during the deep pass, and on one line a long one was cut off at both
                     ends of the panel. Trimming would not do either, because it eats the
                     end of the line and the end is where the file name is. The reserved
                     two lines stop the bar and the button below hopping up and down as the
                     message changes length from file to file. -->
                <Grid MinHeight="44">
                    <TextBlock Text="{Binding ProgressMessage}" FontSize="16"
                               TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <!-- OneWay is required, not stylistic: ProgressBar.Value binds TwoWay by
                     default, and a two-way binding onto a get-only property throws at load. -->
                <ProgressBar Height="4" Margin="0,20,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Background="{StaticResource PanelRaised}"
                             Foreground="{StaticResource Accent}" BorderThickness="0"/>
                <Button Content="Cancel" Style="{StaticResource Btn}" Margin="0,22,0,0"
                        HorizontalAlignment="Center" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ============ Results ============ -->
        <Grid Grid.Row="1" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding ArtifactName}" FontSize="16" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}"/>
                            <TextBlock Text=" · " Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Export Markdown" Style="{StaticResource Btn}"
                                Command="{Binding ExportMarkdownCommand}"/>
                        <Button Content="Export JSON" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                Command="{Binding ExportJsonCommand}"/>
                        <!-- Its own button rather than an option on the two above. The choice is
                             what may be published, not how it is formatted, and a tick box whose
                             state somebody has forgotten is the wrong way to make that one. -->
                        <Button Content="Export for sharing" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                ToolTip="Markdown with the quoted code, file names and hash removed, so it can be posted in public."
                                Command="{Binding ExportForSharingCommand}"/>
                        <Button Content="Scan another" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Centred, like every other screen. Pinned left, a wide window left the report in
                 a column against one edge with an empty half beside it, which reads as a layout
                 that failed rather than one that chose a measure. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel MaxWidth="900" HorizontalAlignment="Center">

                    <!-- What the scan observed but cannot judge, asked instead of guessed.

                         Reading a browser's cookie database is a cleaner doing its job and a
                         password stealer doing its job, and no static analysis separates them.
                         This sits in place of the banner rather than after it: showing "do not
                         install" first and withdrawing it once answered is how a reader learns
                         that alarming banners get retracted. Absent entirely once anything
                         fired that an answer could not change. -->
                    <ItemsControl ItemsSource="{Binding Questions}"
                                  Visibility="{Binding AwaitingAnswer,
                                                       Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16" Margin="0,0,0,14"
                                        CornerRadius="{DynamicResource CardRadius}"
                                        Background="{DynamicResource PanelRaised}"
                                        BorderBrush="{StaticResource Medium}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Statement}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Medium}"/>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource Caption}"
                                                   Text="{Binding Context}"/>
                                        <!-- The author's own note, when the source carried one
                                             and the deep pass read it. Shown so somebody who
                                             already wrote down why is asked to confirm rather
                                             than retype, and disclaimed in the same breath: a
                                             comment ships inside the thing being examined. -->
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Muted}"
                                                   Text="{Binding StatedInSourceLine}"
                                                   Visibility="{Binding StatedInSourceLine,
                                                                Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Prompt}"/>
                                        <!-- Styled like every other button in the window. Left
                                             unstyled they render as dark text on a dark panel
                                             and read as disabled, which on the one control the
                                             verdict is waiting for is the worst place for it. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Yes, that is what it is for"
                                                    Style="{StaticResource Btn}"
                                                    Command="{Binding HasReasonCommand}"/>
                                            <Button Content="No, or I am not sure"
                                                    Style="{StaticResource Btn}" Margin="8,0,0,0"
                                                    Command="{Binding NoReasonCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What the reader accounted for, where the banner would have been. A
                         result that went quiet because somebody vouched for the application
                         has to say so on the same screen as the number. -->
                    <Border Padding="16" Margin="0,0,0,14"
                            CornerRadius="{DynamicResource CardRadius}"
                            Background="{DynamicResource PanelRaised}"
                            BorderBrush="{StaticResource Medium}" BorderThickness="1"
                            Visibility="{Binding HasAccountedFor,
                                                 Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Accounted for as intended"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Medium}"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="You told VibeCheck this application has a reason for the following. Without that, each would advise against installing it."/>
                            <TextBlock Text="{Binding AccountedForReasons}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Do-not-install banner. Only appears when a blocking rule fired, never
                         merely because the score is low, and never while a question that could
                         change it is still on screen. -->
                    <Border Padding="16" Margin="0,0,0,14"
                            CornerRadius="{DynamicResource CardRadius}"
                            Background="{DynamicResource CriticalFill}"
                            BorderBrush="{StaticResource Critical}" BorderThickness="1"
                            Visibility="{Binding ShowInstallBanner,
                                                 Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Do not install this application"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Critical}"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="The following put the person running this software at risk:"/>
                            <TextBlock Text="{Binding BlockingReasons}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Verdict -->
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ScoreDisplay}" FontWeight="Light"
                                           FontSize="{DynamicResource ScoreSize}"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           Foreground="{Binding Band, Converter={StaticResource BandBrush}}"/>
                                <TextBlock Text="{Binding BandLabel}" FontSize="17" Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Band, Converter={StaticResource BandBrush}}"/>
                            </StackPanel>

                            <!-- What the number is. Never omitted: it is the worse of the two
                                 readings rather than an answer to this reader's own question,
                                 and unlabelled it would be taken for the latter. -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ScoreCaption}"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  " Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>

                                <!-- Switching re-answers the report already in hand. Nothing is
                                     rescanned, so the two views can never disagree about what
                                     was found, only about what it means for the reader. -->
                                <Button Command="{Binding SwitchAudienceCommand}"
                                        Content="{Binding SwitchAudienceLabel}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Cursor="Hand" VerticalAlignment="Center"
                                        Foreground="{StaticResource Accent}" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AudienceSummary}"
                                       Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- How the number was reached, directly under it. A low score with
                                 no account of itself reads as a verdict rather than a
                                 measurement, and gives an author no way to tell a scan that
                                 found one serious problem from one that found forty. -->
                            <ItemsControl ItemsSource="{Binding ScoreExplanation}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SummaryLine}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                            <!-- Shown when nothing meaningful could be read. Stated plainly so
                                 an unexamined artifact is never mistaken for a clean one. -->
                            <Border Margin="0,12,0,0" Padding="12"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Background="{StaticResource PanelRaised}"
                                    Visibility="{Binding HasMeaningfulScore,
                                                         Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="No score is given, because too little of this artifact could be read for one to mean anything. This is not a pass and not a failure: the application was not examined. See coverage below."/>
                            </Border>

                            <!-- The same treatment for a class of check that could not run at
                                 all. A shipped application with no lock file scores 100 under
                                 "no known issues found" beside a coverage meter reading 100%
                                 readable, while nothing whatever is known about the packages
                                 inside it. That was already in the report, four cards down,
                                 which is three further than anybody scrolls before deciding. -->
                            <!-- What the reader declared, printed back where the number is. It
                                 excused nothing by itself, but it decided how every capability
                                 question was worded, so a quiet report has to show it. -->
                            <Border Margin="0,12,0,0" Padding="12"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    Visibility="{Binding DeclaredKindAttribution,
                                                         Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding DeclaredKindAttribution}"/>
                            </Border>

                            <!-- Level with the number, because the number cannot carry this. The
                                 score counts deterministic findings only, so that two readers
                                 using two different models can compare it at all; the cost is a
                                 headline that knows nothing about what the deep pass found. One
                                 unchanged application scored 99 by rules, 41 through a local 7B
                                 and 75 through Opus 5, which is why the number stopped moving
                                 with the model and why this sentence sits where the number is. -->
                            <Border Margin="0,12,0,0" Padding="12"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Medium}" BorderThickness="1"
                                    Visibility="{Binding InferredSummary,
                                                         Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding InferredSummary}"/>
                            </Border>

                            <Border Margin="0,12,0,0" Padding="12"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Medium}" BorderThickness="1"
                                    Visibility="{Binding DependencyCaveat,
                                                         Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding DependencyCaveat}"/>
                            </Border>

                            <!-- Same placement, different claim. The dependency caveat says a
                                 check could not run; this says the checks ran but what they
                                 quote back is a fragment of a bundle nobody can read. An app
                                 that is 99% minified reported 100% readable and 100/100. -->
                            <Border Margin="0,12,0,0" Padding="12"
                                    CornerRadius="{DynamicResource ButtonRadius}"
                                    Background="{StaticResource PanelRaised}"
                                    BorderBrush="{StaticResource Medium}" BorderThickness="1"
                                    Visibility="{Binding MinificationCaveat,
                                                         Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding MinificationCaveat}"/>
                            </Border>

                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="A clean result is not proof that an application is safe. Static analysis can show that problems are present; it cannot show that none are."/>
                        </StackPanel>
                    </ContentControl>

                    <!-- Coverage.

                         The first of the seven folding sections, and the first to start folded.
                         Two open with the report: Findings, because it is what a reader came
                         for, and what could not be checked, because it is what stops a short
                         findings list being mistaken for a clean one. The other five are the
                         workings, and thirty eight check rows between the score and the
                         findings is a scroll rather than a reading. Nothing is hidden by
                         starting closed: every header states how much is inside it, which is
                         the condition under which folding is a convenience rather than a way
                         for the report to say less. -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="CoverageSection" Style="{StaticResource SectionHeader}"
                                          Content="Coverage" Tag="{Binding CoverageCount}" IsChecked="False"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=CoverageSection,
                                                     Converter={StaticResource BoolToVisibility}}">

                                <Grid>
                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding CoveragePercent, Mode=OneWay}"
                                                 Background="{StaticResource PanelRaised}"
                                                 Foreground="{StaticResource Accent}" BorderThickness="0"/>
                                </Grid>

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding CoveragePercent, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="% of this application was readable. "/><Run Text="{Binding CoverageBasis, Mode=OneWay}"/>
                                </TextBlock>

                                <Border Margin="0,12,0,0" Padding="12"
                                        CornerRadius="{DynamicResource ButtonRadius}"
                                        Background="{StaticResource PanelRaised}"
                                        Visibility="{Binding CoverageIsLow,
                                                             Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                               Text="Coverage is low, so treat the findings below as a floor rather than a complete picture. Most of this application could not be inspected."/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- Every check and what became of it. A report of failures alone tells an
                         author what is wrong and nothing about how much was examined and found
                         sound, which reads as an accusation rather than an assessment. -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Checks.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="ChecksSection" Style="{StaticResource SectionHeader}"
                                          Content="Source code checks" Tag="{Binding ChecksCount}" IsChecked="False"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=ChecksSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ChecksSummary}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <!-- Named precisely. This is the rule catalog that runs over
                                     recovered source; packaging, dependency and binary checks are
                                     separate passes and are not counted here. A list headed
                                     "Checks" would imply it covered all of them. -->
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,2,0,8"
                                           Text="Packaging, dependency and binary checks run separately and are not counted here."/>

                                <ItemsControl ItemsSource="{Binding Checks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Three glyphs, three colours. A pass and a check
                                                     that never ran must not read alike. -->
                                                <TextBlock Grid.Column="0" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Text="&#xE73E;" Foreground="{StaticResource Good}"
                                                           Visibility="{Binding Passed,
                                                                        Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Grid.Column="0" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Text="&#xE7BA;" Foreground="{StaticResource High}"
                                                           Visibility="{Binding FoundIssues,
                                                                        Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Grid.Column="0" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Text="&#xE738;" Foreground="{StaticResource Muted}"
                                                           Visibility="{Binding NotChecked,
                                                                        Converter={StaticResource BoolToVisibility}}"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               ToolTipService.ShowDuration="60000"
                                                               ToolTipService.InitialShowDelay="350"
                                                               Visibility="{Binding ShowId,
                                                                            Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock.ToolTip>
                                                            <ToolTip MaxWidth="420">
                                                                <TextBlock Text="{Binding FamilyTooltip}"
                                                                           TextWrapping="Wrap"/>
                                                            </ToolTip>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                           Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- Category scores -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding CategoryScores.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="CategoriesSection" Style="{StaticResource SectionHeader}"
                                          Content="Scores by category" Tag="{Binding CategoriesCount}" IsChecked="False"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=CategoriesSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding CategoryScores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                                <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                                             Value="{Binding Score, Mode=OneWay}"
                                                             VerticalAlignment="Center"
                                                             Background="{StaticResource PanelRaised}"
                                                             Foreground="{StaticResource Accent}"
                                                             BorderThickness="0" Margin="10,0"/>
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                           Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Score, Mode=OneWay}"/><Run Text="/100"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="Categories not listed had no findings. That means nothing was found there, which is not the same as nothing being there."/>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- Findings -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Findings.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="FindingsSection" Style="{StaticResource SectionHeader}"
                                          Content="Findings" Tag="{Binding FindingsCount}" IsChecked="True"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=FindingsSection,
                                                     Converter={StaticResource BoolToVisibility}}">

                                <!-- Said once for the list rather than on every card. Each inferred
                                     finding quotes the code it rests on, so the reader checks the
                                     claim against the source instead of against a warning they
                                     stopped reading after the second one. -->
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Findings tagged AI came from the deep pass. They are reasoned from the code quoted with each one rather than matched by a rule, and none of them alone can advise against installing."
                                           Visibility="{Binding HasAssistedFindings,
                                                        Converter={StaticResource BoolToVisibility}}"/>

                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The row is outlined in its own severity rather than
                                                 in the neutral edge, so the colour reaches the
                                                 whole finding instead of only the bar and the word
                                                 inside it. Same converter and the same brush, so a
                                                 theme that restates the ramp restates this too and
                                                 the outline can never disagree with the label it
                                                 surrounds. -->
                                            <Border Margin="0,0,0,8"
                                                    CornerRadius="{DynamicResource ButtonRadius}"
                                                    Background="{StaticResource PanelRaised}"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding Severity,
                                                                  Converter={StaticResource SeverityBrush}}">
                                                <StackPanel>
                                                    <!-- Header row toggles the detail open. -->
                                                    <ToggleButton IsChecked="{Binding Expanded}" Cursor="Hand"
                                                                  Background="Transparent" BorderThickness="0"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="12,10">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="78"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                                                       Fill="{Binding Severity,
                                                                              Converter={StaticResource SeverityBrush}}"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                                       Foreground="{Binding Severity,
                                                                                    Converter={StaticResource SeverityBrush}}"/>

                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <!-- The code is worth showing and worthless
                                                                         unread, so it explains itself on hover. -->
                                                                    <TextBlock Text="{Binding SourceTag}"
                                                                               Style="{StaticResource Caption}"
                                                                               FontFamily="{DynamicResource MonoFont}"
                                                                               ToolTipService.ShowDuration="60000"
                                                                               ToolTipService.InitialShowDelay="350"
                                                                               Visibility="{Binding ShowRuleId,
                                                                                            Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock.ToolTip>
                                                                            <ToolTip MaxWidth="420">
                                                                                <TextBlock Text="{Binding FamilyTooltip}"
                                                                                           TextWrapping="Wrap"/>
                                                                            </ToolTip>
                                                                        </TextBlock.ToolTip>
                                                                    </TextBlock>
                                                                    <TextBlock Text="  ·  " Style="{StaticResource Caption}"
                                                                               Visibility="{Binding ShowRuleId,
                                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                                    <TextBlock Text="{Binding Location}"
                                                                               Style="{StaticResource Caption}"
                                                                               FontFamily="{DynamicResource MonoFont}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ToggleButton>

                                                    <!-- Detail -->
                                                    <StackPanel Margin="26,0,14,14"
                                                                Visibility="{Binding Expanded,
                                                                             Converter={StaticResource BoolToVisibility}}">

                                                        <!-- Evidence first, claim second. The quoted
                                                             line is the part a reader can check,
                                                             and leading with it makes the text
                                                             below a reading of something in front
                                                             of them rather than an assertion to be
                                                             taken on trust. The per-finding "this
                                                             may be wrong" banner that used to sit
                                                             here is gone: repeated on every card it
                                                             stopped being read and started looking
                                                             like a tool hedging its own output. It
                                                             is said once above the list instead. -->
                                                        <Border Margin="0,0,0,10" Padding="10"
                                                                CornerRadius="{DynamicResource ButtonRadius}"
                                                                Background="{StaticResource Bg}"
                                                                Visibility="{Binding Evidence,
                                                                             Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="{Binding Evidence}" FontFamily="{DynamicResource MonoFont}"
                                                                       FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Muted}"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>

                                                        <StackPanel Margin="0,10,0,0"
                                                                    Visibility="{Binding Remediation,
                                                                                 Converter={StaticResource NullToVisibility}}">
                                                            <TextBlock Text="{Binding RemediationLabel}"
                                                                       FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}"
                                                                   Visibility="{Binding Reference,
                                                                                Converter={StaticResource NullToVisibility}}">
                                                            <Hyperlink NavigateUri="{Binding Reference}"
                                                                       RequestNavigate="OnNavigate"
                                                                       Foreground="{StaticResource Accent}">
                                                                <TextBlock Text="{Binding Reference}"/>
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- What this application can do.

                         Not findings, and deliberately not coloured, counted or scored like
                         them. Auto-updating and starting with Windows are how a great many
                         correct programs work; rated as defects they cost a working application
                         a whole band of score for having a feature, which is how a scanner
                         teaches people to stop reading it.

                         Open by default for the reader who downloaded this and closed for the
                         one who wrote it, because only one of them is learning something. The
                         binding is one-way: switching reader re-folds it, which is the intent
                         rather than a limitation. -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Capabilities.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="CapabilitiesSection" Style="{StaticResource SectionHeader}"
                                          Content="What this application can do"
                                          Tag="{Binding CapabilitiesCount}"
                                          IsChecked="{Binding IsEndUser, Mode=OneWay}"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=CapabilitiesSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,0,0,10"
                                           Text="Not problems, and none of this affects the score. These are things the application is built to do that are worth knowing before you run it."/>

                                <ItemsControl ItemsSource="{Binding Capabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12,10"
                                                    CornerRadius="{DynamicResource ButtonRadius}"
                                                    Background="{StaticResource PanelRaised}"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource Edge}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Location}"
                                                               Style="{StaticResource Caption}"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Remediation}"
                                                               Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                                               Visibility="{Binding Remediation,
                                                                            Converter={StaticResource NullToVisibility}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- What this scan did. The counterpart to the limitations card below: a
                         result that lands in under two seconds reads as skipped unless the work
                         behind it is stated, and the honest way to answer that is to show the
                         receipt rather than to slow the scan down. -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Effort.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="EffortSection" Style="{StaticResource SectionHeader}"
                                          Content="What this scan did" IsChecked="False"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=EffortSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Effort}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Says the quiet part, for the reader who noticed that the bar
                                     ran for longer than this number and wondered which of the
                                     two was lying. Neither: the work is genuinely this fast,
                                     and the readout is paced so its stages can be read. It
                                     never reports progress that has not happened. -->
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}">
                                    <Run Text="All of it in"/><Run Text=" "/><Run Text="{Binding DurationLabel, Mode=OneWay}"/><Run Text=". Static analysis is fast; a quick result is not a shallow one, and the figures above are what it covered. The progress bar is paced so that each stage can be read, so it runs for longer than the work it reports, and never ahead of it."/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- What could not be checked.

                         Open with the report, like Findings and unlike the other five. This is
                         the section that stops a short findings list reading as a clean bill of
                         health, so it is the one section whose value depends on being read
                         rather than being available. Somebody who has decided they do not want
                         it can still fold it; it just does not start that way. -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,0"
                                    Visibility="{Binding Limitations.Count,
                                                 Converter={StaticResource CountToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="LimitationsSection" Style="{StaticResource SectionHeader}"
                                          Content="What could not be checked" Tag="{Binding LimitationsCount}" IsChecked="True"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=LimitationsSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="These checks did not run. Their absence from the findings above means they were not performed, not that they passed."/>
                                <ItemsControl ItemsSource="{Binding Limitations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5"
                                                       Style="{StaticResource Caption}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <!-- Provenance -->
                    <ContentControl Style="{StaticResource Card}" Margin="0,14,0,24">
                        <StackPanel>
                            <ToggleButton x:Name="ProvenanceSection" Style="{StaticResource SectionHeader}"
                                          Content="Vulnerability data" IsChecked="False"/>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, ElementName=ProvenanceSection,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding VulnerabilitySummary}" TextWrapping="Wrap"/>

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           Text="{Binding BundleNote}"
                                           Visibility="{Binding BundleNote,
                                                        Converter={StaticResource NullToVisibility}}"/>

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           Text="{Binding Sha256, StringFormat=SHA-256 {0}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Status bar ============
             It closes the window at the bottom, and while it is there it may as well carry the
             one claim this application is built around. What leaves the machine used to appear
             on the drop screen and nowhere else, so the reader was told what was uploaded only
             while there was nothing to upload; here it is in view during a scan and while
             reading the report, and it changes when the deep pass is switched on. The version
             that used to sit here is already in the title bar. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock Text="{Binding NetworkSummary}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Sha256, StringFormat=SHA-256 {0}}"
                           Visibility="{Binding HasResults,
                                        Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Last child, so it is the topmost thing in the window. Empty in the default
             theme. -->
        <ContentControl Grid.Row="0" Grid.RowSpan="3"
                        Template="{DynamicResource WindowOverlay}"
                        IsHitTestVisible="False" Focusable="False"/>
    </Grid>
</Window>
