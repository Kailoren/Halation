<Application x:Class="VibeCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:VibeCheck.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Everything visual lives in the theme; this file keeps only the converters,
                 which are behaviour rather than appearance. A loose theme.xaml in the user's
                 data folder is merged over this at startup, so the two are kept apart on
                 purpose: an override should not have to redeclare a converter in order to
                 change a colour. See ThemeLoader. -->
            <ResourceDictionary.MergedDictionaries>
                <!-- The one shipped theme. A loose copy at %LOCALAPPDATA%\VibeCheck\theme.xaml
                     is merged over this at startup by ThemeLoader if one exists, so a reader
                     can still restyle the application without a rebuild. -->
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <app:SeverityBrushConverter x:Key="SeverityBrush"/>
            <app:BandBrushConverter x:Key="BandBrush"/>
            <app:BoolToVisibility x:Key="BoolToVisibility"/>
            <app:InverseBoolToVisibility x:Key="InverseBoolToVisibility"/>
            <app:NullToVisibility x:Key="NullToVisibility"/>
            <app:CountToVisibility x:Key="CountToVisibility"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
