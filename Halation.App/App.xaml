<Application x:Class="Halation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Halation.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Everything visual lives in the theme; this file keeps only the converters,
                 which are behaviour rather than appearance. Kept apart so that changing a
                 colour never means touching a converter. -->
            <ResourceDictionary.MergedDictionaries>
                <!-- The one theme, compiled in. Reading a theme from disk was removed: it
                     handed a user-supplied file to XamlReader, and XAML names types the parser
                     then builds, so a theme file was an executable. -->
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <app:SeverityBrushConverter x:Key="SeverityBrush"/>
            <app:BandBrushConverter x:Key="BandBrush"/>
            <app:BoolToVisibility x:Key="BoolToVisibility"/>
            <app:InverseBoolToVisibility x:Key="InverseBoolToVisibility"/>
            <app:NullToVisibility x:Key="NullToVisibility"/>
            <app:CountToVisibility x:Key="CountToVisibility"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
