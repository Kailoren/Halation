<?xml version="1.0" encoding="utf-8"?>
<!--
    The Halation theme. The only one that ships, and compiled into the assembly.

    Every colour, font and metric the interface uses is a named key in here. Nothing visual
    should be hardcoded in a window: if a value cannot be changed from this file, that is a
    bug in the theme rather than a preference of the window.

    That principle used to stop at colour. A theme could recolour the interface but not
    restyle it, because the shape of a card and the way a button responds to a pointer lived
    inside the window's markup where nothing could reach them. Both now live here, as
    templates, and the window holds only arrangement. A theme that wants notched corners, a
    glow, or a slower hover overrides a template rather than asking for a code change.

    This is the only theme and it is compiled in, so restyling means editing this file and
    rebuilding. Loading one from disk was removed deliberately: it handed a user-supplied file
    to XamlReader, and XAML names types that the parser then constructs, so "drop this theme in
    your folder" ran whatever it named.

    See THEME.md beside this file for what each key controls.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================
         Palette

         Near-black with a yellow accent and a lime edge. Yellow is the accent rather than the
         background: black on yellow suits a landing page, drowns a several-thousand-word
         report, and swamps the severity ramp.

         The severity colours are the load-bearing ones. They carry meaning rather than
         decoration, and they are the one place where a change alters what a glance
         communicates rather than how it looks. Changing the neutrals is safe; changing the
         ramp is a decision about the product.
         ==================================================================== -->


    <SolidColorBrush x:Key="Bg" Color="#050505" />
    <SolidColorBrush x:Key="Panel" Color="#E80D0D0B" />
    <SolidColorBrush x:Key="PanelRaised" Color="#F016160A" />
    <SolidColorBrush x:Key="Edge" Color="#5C8AE66E" />
    <SolidColorBrush x:Key="Text" Color="#EDEDED" />
    <SolidColorBrush x:Key="Muted" Color="#B5AE7A" />
    <SolidColorBrush x:Key="Accent" Color="#F9F002" />

    <!-- Was hardcoded inside two control templates, which made hover the one thing a theme
         could not touch. -->
    <SolidColorBrush x:Key="Hover" Color="#231F05" />
    <SolidColorBrush x:Key="CloseHover" Color="#FF003C" />
    <SolidColorBrush x:Key="OnDanger" Color="#000000" />

    <!-- The accent at low alpha, for a surface that is being pointed at or dragged onto rather
         than merely hovered. Translucent on purpose: it is laid over whatever it highlights, so
         one key covers every such surface whatever colour that surface happens to be, and every
         one of them is then the same colour as the others by construction rather than because
         somebody copied a hex value. -->
    <SolidColorBrush x:Key="AccentWash" Color="#1FF9F002" />

    <!-- Severity ramp. Read left to right as worsening; keep them distinguishable to a
         colour-blind reader by lightness as well as by hue. -->
    <SolidColorBrush x:Key="Critical" Color="#FF003C" />
    <SolidColorBrush x:Key="High" Color="#FF5A28" />
    <SolidColorBrush x:Key="Medium" Color="#F9F002" />
    <SolidColorBrush x:Key="Low" Color="#2FB6D4" />
    <SolidColorBrush x:Key="Good" Color="#39FF14" />

    <!-- "Could not analyse" is grey, never green. An artifact that was never read must not
         look like one that passed, and keeping those visually distinct is the entire point of
         having the band. If a theme makes this green, the theme is lying for the tool. -->
    <SolidColorBrush x:Key="Unknown" Color="#6B7280" />

    <!-- Filled panels that belong to a severity: the do-not-install banner and the note that
         marks a finding as inferred by the deep pass. Both were hardcoded browns in the window
         markup, which made the two loudest surfaces in the application the two a theme could
         not touch.

         Opaque rather than a wash, unlike AccentWash. These are not laid over something to
         tint it, they are the surface, and they are dark enough that the severity they belong
         to has to be readable against them. A theme is free to make them translucent; the
         default does not, because these two values were chosen against the default background
         and picking them apart into a tint would change how they look for no gain. -->
    <SolidColorBrush x:Key="CriticalFill" Color="#E6330A16" />
    <SolidColorBrush x:Key="MediumFill" Color="#E6231F05" />

    <!-- ====================================================================
         Typography and metrics
         ==================================================================== -->

    <!-- Every face is compiled into the executable and addressed by pack URI, so the
         application draws the same on a machine with none of them installed as it does on the
         one it was built on. Named faces were tried first and are the reason this is here: a
         FontFamily that names "Barlow" asks whichever machine it lands on, and one without
         Barlow quietly draws Segoe UI instead. The program still opens, still works, and looks
         like a different program, with nothing in a screenshot to say why.

         The URI form matters and is the reason this comment is long. A relative "./Fonts/#Barlow"
         resolves against the folder holding this dictionary, which is Themes/, so it looked for
         Themes/Fonts and found nothing; a font URI that resolves to nothing does not throw, it
         falls back, and on a machine with Barlow installed the fallback is Barlow. It looked
         perfect here and would have shipped drawing Segoe UI for everybody else. The absolute
         pack URI names the assembly, which is Halation rather than Halation.App, and the part
         after the hash is the family's own internal name rather than its file name.
         Fonts/README.md records what each file is. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Halation;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Halation;component/Fonts/#Cascadia Mono</FontFamily>

    <!-- Headings, the app name and the score. Separate from UiFont because display faces are
         usually wide and unreadable at body size, so a theme wanting one needs somewhere to
         put it that is not the paragraph text. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Halation;component/Fonts/#Oxanium</FontFamily>

    <!-- Segoe MDL2 Assets supplies the title bar glyphs. Replacing it means replacing the
         glyph codes in the window markup too. -->
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="BodySize">13</sys:Double>
    <sys:Double x:Key="CaptionSize">12</sys:Double>
    <sys:Double x:Key="HeadingSize">15</sys:Double>
    <sys:Double x:Key="ScoreSize">42</sys:Double>

    <CornerRadius x:Key="CardRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">0</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ButtonPadding">14,7</Thickness>
    <sys:Double x:Key="CaptionHeight">36</sys:Double>

    <!-- ====================================================================
         Motion

         Durations rather than storyboards, because a storyboard cannot usefully be swapped by
         key: the animations below live inside control templates and name the elements they
         move, so a replacement would have to know those names anyway. A theme that only wants
         the interface to feel faster or calmer changes these two numbers; a theme that wants
         different motion overrides the template, which is where motion belongs.

         The templates below reach these with StaticResource on purpose. Timelines are
         Freezables rather than framework elements, and DynamicResource has no element tree to
         walk from inside one, so it silently resolves to nothing. StaticResource within this
         same dictionary is resolved at load and works. The consequence is the same one that
         BasedOn has further down: overriding SwiftDuration alone does not reach these
         templates, and a theme that wants different timing overrides the template too.

         Everything here animates Opacity or RenderTransform, and nothing else. Those are
         plain dependency properties on framework elements, so they compose, they do not
         invalidate layout, and they cannot hit the "cannot animate on an immutable object"
         wall that catches anyone trying to animate a brush or an effect directly. A theme
         adding motion should stay inside that rule: fade a dedicated layer in and out rather
         than animating the thing it decorates.
         ==================================================================== -->

    <Duration x:Key="SwiftDuration">0:0:0.07</Duration>
    <Duration x:Key="CalmDuration">0:0:0.22</Duration>

    <!-- ====================================================================
         Decoration slots

         Empty here, and that is the point. Each is a template the window mounts but the
         default theme declines to fill, so the neutral look costs nothing and a theme can add
         atmosphere without the window growing a single element on its behalf. All of them are
         mounted behind IsHitTestVisible="False", so whatever a theme puts in one can never
         swallow a click.

         The glow slots are x:Null rather than absent so that the key exists to be found and
         to be documented. Effect="{DynamicResource CardGlow}" against a missing key is legal
         and does nothing, which is the same result by accident instead of on purpose.
         ==================================================================== -->

    <!-- Behind everything, above the window background. For gradients, grain, scanlines,
         anything that should sit under the entire interface. -->
    <ControlTemplate x:Key="WindowBackdrop" TargetType="ContentControl">
        <Grid ClipToBounds="True">

            <!-- 1. Wash. Warm at the top where the title bar is, falling to the flat near
                 black the palette calls Bg by the bottom of the window. -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.2" RadiusY="1.0">
                        <GradientStop Color="#171406" Offset="0" />
                        <GradientStop Color="#0A0A06" Offset="0.55" />
                        <GradientStop Color="#050505" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2. Survey grid. Two hairlines per 64px tile, at about four percent alpha, so
                 it is felt rather than seen. -->
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Stretch="None" Viewport="0,0,64,64" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#0BF9F002">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,64,1" />
                                        <RectangleGeometry Rect="0,0,1,64" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 3. Scanlines. Black rather than yellow, so this darkens alternate rows the way
                 a CRT does instead of tinting the whole window. -->
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Stretch="None" Viewport="0,0,3,3" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#1C000000">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,3,1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 4. The sweep. A soft band of the accent yellow falling down the window on a
                 nine second loop. Its travel is in fixed pixels rather than proportional
                 because a RenderTransform has no idea how tall its parent is; 1600 clears any
                 window anyone will open this on, and overshooting simply means it has already
                 left the bottom edge when the loop restarts. -->
            <Rectangle x:Name="Sweep" Height="280" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F9F002" Offset="0" />
                        <GradientStop Color="#0FF9F002" Offset="0.5" />
                        <GradientStop Color="#00F9F002" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform Y="-280" />
                </Rectangle.RenderTransform>
            </Rectangle>

        </Grid>

        <!-- On the template rather than on the Grid, which is where it used to be. Pause and
             Resume find their storyboard by name, and the name is only in scope within the same
             trigger collection, so the one that starts it has to live beside the ones that
             stop it. -->
        <!-- One DataTrigger starts and stops the sweep, and there is no Loaded trigger at all.
             Both of the obvious alternatives were tried and neither works here:

             A Loaded EventTrigger in ControlTemplate.Triggers never fires. It parses, it
             raises nothing, and the sweep sits at its start value forever. That failure is
             invisible in a screenshot, and it survived one round of checking because the drop
             zone breathing elsewhere on screen made consecutive frames differ, which was read
             as proof the sweep was moving. It was not. Reading the animated offset is the only
             honest check.

             Pause and Resume need their BeginStoryboard's name in the same trigger collection.
             The collection that does work for Loaded is the root Grid's own Triggers, and that
             one accepts nothing but EventTriggers, so the pause could never live beside the
             thing it pauses.

             Driving it from IsMinimised solves both at once: the trigger fires on load because
             the value starts false, and the same trigger owns the stop. Stopping rather than
             pausing means the sweep restarts its pass on restore instead of resuming mid-way,
             which for a nine second ambient drift is not a difference anyone can see. -->
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMinimised}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Sweeping">
                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="20">
                            <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-280" To="1600" Duration="0:0:9" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Sweeping" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- In front of everything. For vignettes, CRT curvature, glass. Keep it faint: this
         layer covers the findings, and the findings are the product. -->
    <ControlTemplate x:Key="WindowOverlay" TargetType="ContentControl">
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00000000" Offset="0.5" />
                    <GradientStop Color="#2E000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </ControlTemplate>

    <!-- Inside every card, between its border and its content. For corner cuts and ticks. -->
    <ControlTemplate x:Key="CardChrome" TargetType="ContentControl" />

    <!-- Effects, applied to the border elements alone rather than to whole controls. An Effect
         rasterises the subtree it is set on, so putting one on a card would push every
         paragraph inside it through the same intermediate surface and cost the text its
         subpixel antialiasing. The templates below keep each border as an empty sibling of the
         content for exactly this reason: the glow is free to be expensive because nothing
         readable is inside it. -->
    <DropShadowEffect x:Key="CardGlow" Color="#F9F002" ShadowDepth="0" BlurRadius="18" Opacity="0.45" />
    <DropShadowEffect x:Key="ButtonGlow" Color="#F9F002" ShadowDepth="0" BlurRadius="14" Opacity="0.85" />
    <DropShadowEffect x:Key="DropZoneGlow" Color="#F9F002" ShadowDepth="0" BlurRadius="34" Opacity="0.9" />

    <!-- ====================================================================
         Control styles
         ==================================================================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource HeadingSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}" />
    </Style>

    <!-- Cards.

         A ContentControl rather than a Border, which is the change that makes a card a shape a
         theme owns instead of a rectangle the window draws. A Border has exactly one child and
         no template, so the only thing a style could say about it was what colour it was; a
         templated control can be given corner cuts, a glow, an overlay and a different
         arrangement entirely without any of the twelve call sites knowing.

         The border is an empty sibling of the content rather than its parent. That is what
         lets CardGlow be a real effect without dragging every paragraph in the card through
         the rasteriser with it. -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>

                        <Grid x:Name="Shape" Effect="{DynamicResource CardGlow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>

                            <!-- Fill: everything but the top right cell, plus the half of that
                                 cell that falls below the diagonal. -->
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}" />
                            <Path Grid.Row="0" Grid.Column="1" Stretch="Fill" Data="M 0,0 L 1,1 L 0,1 Z" Fill="{TemplateBinding Background}" />
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Fill="{TemplateBinding Background}" />

                            <!-- Outline: top, diagonal, left, right below the cut, bottom.
                                 Each meets the next exactly because they all stop at a shared
                                 grid line. -->
                            <Rectangle Grid.Row="0" Grid.Column="0" Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
                            <Path Grid.Row="0" Grid.Column="1" Stretch="Fill" Data="M 0,0 L 1,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="1" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Width="1" HorizontalAlignment="Right" Fill="{TemplateBinding BorderBrush}" />
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
                        </Grid>

                        <!-- Corner ticks. Brackets need no geometry tricks, which is why there
                             are two of these and only one notch. -->
                        <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="{DynamicResource Accent}" StrokeThickness="2" Data="M 1,1 L 1,13 L 13,13" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Accent}" StrokeThickness="2" Data="M 13,1 L 13,13 L 1,13" />

                        <!-- Kept mounted even though this theme leaves it empty, so a theme
                             layered over this one can still decorate a card without having to
                             copy all of the above. -->
                        <ContentControl Template="{DynamicResource CardChrome}" IsHitTestVisible="False" />

                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drop zone, which is the first thing anyone sees and the only element in the
         application worth decorating on its own. Templated for the same reason cards are, and
         separately from them because it is the one card-like thing that reacts: the drag state
         is a real state and a theme should be able to make it feel like one. -->
    <Style x:Key="DropZone" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>

                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- The breathing edge. -->
                        <Border x:Name="Pulse" Opacity="0.45" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#F9F002" ShadowDepth="0" BlurRadius="20" Opacity="0.75" />
                            </Border.Effect>
                        </Border>

                        <!-- Bracket frame. Four corners, each an L, drawn over the border so
                             the zone reads as a targeting reticle rather than a box. -->
                        <Path HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource Accent}" StrokeThickness="3" Data="M 1.5,26 L 1.5,1.5 L 26,1.5" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{DynamicResource Accent}" StrokeThickness="3" Data="M 1.5,1.5 L 26,1.5 L 26,26" />
                        <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="{DynamicResource Accent}" StrokeThickness="3" Data="M 1.5,1.5 L 1.5,26 L 26,26" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Accent}" StrokeThickness="3" Data="M 26,1.5 L 26,26 L 1.5,26" />

                        <!-- Drag state. Flood of the accent at low alpha plus the heavy glow,
                             faded in over the swift duration. -->
                        <Border x:Name="Active" Opacity="0" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Effect="{DynamicResource DropZoneGlow}" />

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- The breath, started and stopped exactly like the backdrop sweep and
                             for the same reasons. A Loaded EventTrigger is not an option here at
                             all: in a template that arrives through a Style setter it throws
                             outright, "'Pulse' name cannot be found in the name scope of
                             ControlTemplate", on the first render rather than at parse time. -->
                        <DataTrigger Binding="{Binding IsMinimised}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Breathing">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="20">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.25" To="0.7" Duration="0:0:1.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Breathing" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- Lit state. Opacity animated rather than the brushes swapped, for
                             the reason set out in Theme.xaml's motion section. -->
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Accent}" BorderThickness="{TemplateBinding BorderThickness}" Effect="{DynamicResource ButtonGlow}" />

                        <!-- The tab down the left edge, always lit. -->
                        <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource Accent}" Opacity="0.8" />

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two audience choices, which are buttons the size of paragraphs rather than
         buttons the size of words.

         They had no style at all until now, which meant they fell through to WPF's stock
         Button template and lit up in the Aero2 mouse-over blue. That blue is baked into the
         framework's own theme dictionary, so it was the one colour in the application that no
         theme could reach and no palette could explain. Anything given to a user to click
         needs a style here, even when the default happens to look acceptable.

         Borderless at rest so the choices read as part of the card they sit in, with the whole
         frame arriving on hover. AccentWash rather than Hover for the fill: this is a
         selection, and it should look like the drop zone accepting a file rather than like a
         toolbar button being passed over. -->
    <Style x:Key="ChoiceBtn" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonRadius}" />

                        <!-- Thickness fixed rather than template-bound, because the control is
                             borderless at rest and binding it would leave the hover state with
                             nothing to draw. -->
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ButtonGlow}" />

                        <!-- Keyboard focus gets its own layer rather than sharing the hover
                             one. Two triggers animating a single Opacity means whichever ran
                             last owns it, and tabbing away while the pointer is still over the
                             control would clear a highlight that should have stayed. -->
                        <Border x:Name="Ring" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" />

                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar buttons. Flat and borderless, and hit-test-visible so WindowChrome hands
         them clicks instead of treating them as drag surface. -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="{DynamicResource CaptionHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource Hover}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The heading of a section that can be folded away.

         A ToggleButton rather than a heading with a click handler on it, because that is what
         it is: a two-state control, and WPF already gives one a focus rectangle, a space bar
         and a name a screen reader can say. The heading text is its Content; its Tag is a
         short count of what the section holds, shown beside the arrow so a folded section
         still says how much is inside it. Folding is a convenience and must never be a way for
         the report to say less than it found.

         Content and Tag are read as text rather than presented, so both must be strings. That
         is the trade for having the heading carry the Heading style: a ContentPresenter would
         take any content and give this template no way to style the words inside it.

         The arrow is a Path rather than a glyph from IconFont. A theme restyling it then draws
         a shape instead of hunting for a code point in a font it may not ship, which is the
         same reason cards are templated controls rather than borders. -->
    <Style x:Key="SectionHeader" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Transparent rather than unset, so the whole strip takes the click and
                         not only the words on it. -->
                    <Grid Background="Transparent">

                        <!-- Both layers are inset negatively so the lit row lines up with the
                             edge of the card's padding rather than with the heading. -->
                        <Border x:Name="Hot" Opacity="0" Margin="-8,-6" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" />

                        <!-- Focus gets its own layer rather than sharing the hover one, for the
                             reason ChoiceBtn gives: two triggers animating one Opacity means
                             whichever ran last owns it. -->
                        <Border x:Name="Ring" Opacity="0" Margin="-8,-6" BorderBrush="{DynamicResource Accent}" BorderThickness="1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Margin cleared: the Heading style spaces itself from the
                                 paragraph it normally sits above, and here that gap belongs to
                                 the content below, which is not always there. -->
                            <TextBlock Grid.Column="0" Style="{DynamicResource Heading}" Margin="0" VerticalAlignment="Center" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />

                            <TextBlock Grid.Column="1" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />

                            <!-- Points down while the section is open and turns a quarter turn
                                 to the right when it closes, so the direction it points is
                                 always the direction the content is. Stretch="None" for the
                                 reason the tick in the CheckBox gives: a stretched Path scales
                                 its stroke with its geometry. -->
                            <Path x:Name="Arrow" Grid.Column="2" Stretch="None" Margin="14,0,2,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,0 L 5,5 L 10,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Written as the closed state rather than the open one because that
                             is the state the arrow has to be turned to: the Path is drawn
                             pointing down, which is where an open section leaves it, so an
                             open one needs no storyboard holding it there. -->
                        <Trigger Property="IsChecked" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Inputs

         Both templated in full, and both for the reason that keeps recurring: WPF's stock
         templates take their colours from the framework's own theme dictionary. The focus ring
         on a PasswordBox and the hover fill on a CheckBox are the Aero2 blues, they are not
         reachable from any palette in this file, and they were the last two places a dark
         yellow application still lit up in Windows blue.

         Implicit, so the check boxes, the password boxes and the endpoint fields get them
         without being told, and so does anything added later. None of them names a colour of
         its own.
         ==================================================================== -->

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" />

                        <!-- Focus and hover get a layer each rather than sharing one. They can
                             be true at the same time, and a single layer driven by both means
                             moving the pointer away clears a ring that should have stayed for
                             as long as the caret is in the field. -->
                        <Border x:Name="Hot" Opacity="0" BorderBrush="{DynamicResource Muted}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" />

                        <Border x:Name="Focused" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ButtonGlow}" />

                        <!-- Named by contract, not by choice: PasswordBox finds where to draw
                             its content by looking for PART_ContentHost and shows nothing at
                             all without it. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same field as the PasswordBox above, for the endpoint and model boxes, which hold
         nothing secret and so are read back. Written out rather than derived from that style
         because a TextBox template cannot be shared with a PasswordBox: the two controls have
         different templated properties, and BasedOn across the two types is not legal XAML. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" />

                        <Border x:Name="Hot" Opacity="0" BorderBrush="{DynamicResource Muted}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" />

                        <Border x:Name="Focused" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ButtonGlow}" />

                        <!-- Named by contract, as on the PasswordBox: a TextBox with no
                             PART_ContentHost renders an empty box that swallows typing. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Focused" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent rather than unset, so the whole row including the gap
                         between box and label is clickable the way the stock one is. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" Background="{DynamicResource PanelRaised}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" />

                            <Border x:Name="Hot" Opacity="0" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ButtonGlow}" />

                            <!-- Stretch="None" on purpose: a stretched Path scales its stroke
                                 with the geometry, so a tick drawn to fit would come out
                                 thicker on one axis than the other. -->
                            <Path x:Name="Tick" Opacity="0" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,4 L 3,7 L 9,0" />
                        </Grid>

                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same control as the CheckBox above in everything but shape, and deliberately so:
         a round mark for "one of these" against a square one for "on or off" is the only thing
         that tells a reader which kind of choice they are looking at. Stock WPF renders both as
         a white Aero2 disc that no palette here can reach, which is the same hole every other
         framework control left. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Box" Fill="{DynamicResource PanelRaised}" Stroke="{DynamicResource Edge}" StrokeThickness="1" />

                            <Ellipse x:Name="Hot" Opacity="0" Stroke="{DynamicResource Accent}" StrokeThickness="1" Effect="{DynamicResource ButtonGlow}" />

                            <Ellipse x:Name="Dot" Opacity="0" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Accent}" />
                        </Grid>

                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Scroll bars

         Templated in full because WPF's stock scroll bar has no seam worth using: its colours
         come from the framework's own theme dictionary, the same place the Aero2 button blue
         lives, so no palette here could reach it. A native light grey bar down the side of a
         dark window was the most visible unthemed thing left in the application.

         The style is implicit, so every ScrollViewer in every window picks it up without being
         told. It carries no colours of its own, only Muted and Accent at graded opacities, so a
         theme that never mentions scroll bars still gets one that matches it.
         ==================================================================== -->

    <!-- The page-up and page-down halves of the track. Invisible but not absent: a Rectangle
         filled with Transparent still takes a hit, which is what makes clicking the empty track
         page the view. Fill="{x:Null}" would look identical and do nothing. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setters rather than storyboards, and deliberately so. An animation outranks a Setter
         for the rest of the element's life, so a faded hover and a Setter-driven drag state on
         one property means the drag colour never appears after the first hover. The rule in the
         motion section stands: animate a layer, or do not animate. A scroll bar does not need
         it enough to earn a second layer. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" Background="{DynamicResource Muted}" Opacity="0.30" CornerRadius="{DynamicResource ButtonRadius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.60" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- PART_Track is not a name, it is the contract: ScrollBar finds its
                             track by that string and silently does nothing without it.
                             Reversed because a vertical track's zero is at the top. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- Orientation is a property rather than a separate control, so the horizontal bar
                 needs its own template. Width has to be released back to Auto or a horizontal
                 bar sits eleven pixels wide in the corner. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- BasedOn is the one reference here that must stay static: WPF resolves style
         inheritance when the dictionary loads and throws outright on a DynamicResource.
         It means overriding CaptionBtn alone does not reach CloseBtn, so a theme that
         restyles one should restyle both. -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hot" Opacity="0" Background="{DynamicResource CloseHover}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource SwiftDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource CalmDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ToolTip ============
         Another hole in the theme until it was needed: with no style, WPF draws its own pale
         yellow box with a system border, which on this palette looks like a different program
         has appeared over the top of the report. Templated rather than merely recoloured,
         because the default carries a drop shadow and a border thickness no setter reaches. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ButtonRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
