<Window x:Class="VibeCheck.App.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Deep pass API key"
        Width="560"
        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource BodySize}"
        WindowStyle="None" AllowsTransparency="False">

    <!-- Sizes to whatever the explanatory text wraps to. It was a fixed 300 and the buttons
         fell off the bottom: the paragraphs above them wrap to a different number of lines
         depending on the font and DPI, so any fixed height is a guess that is wrong on
         somebody's machine. -->
    <Window.SizeToContent>Height</Window.SizeToContent>

    <!-- Same chrome arrangement as MainWindow, so the dialog does not arrive wearing the
         default Windows title bar in the middle of a dark themed application. Resize border
         is zero because this window is not resizable. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Deep pass API key" FontWeight="SemiBold"
                           Margin="14,0" VerticalAlignment="Center"/>

                <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="OnCancel"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="Anthropic API key" Style="{StaticResource Heading}"/>

            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="The deep pass runs on your own account. Create a key at console.anthropic.com and paste it below. It is encrypted to your Windows account and stored outside this application's folder."/>

            <!-- PasswordBox, not TextBox: the key should not be readable over a shoulder or in a
                 screenshot, and it is never displayed again once stored. -->
            <!-- Everything this used to state inline now comes from the implicit PasswordBox
                 style, including the focus ring that used to be Windows blue. -->
            <PasswordBox x:Name="KeyBox" Height="30"/>

            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Only the files selected by triage are sent, and only on scans where you turn the deep pass on. Leave the box empty and save to remove a stored key."/>

            <!-- The figure, not a reassuring adjective. This said "a few cents per scan", which
                 is true only of a tiny application: the pass sends up to forty files and each
                 one is a fresh request, so a real application is dollars rather than cents. A
                 scanner whose value is that it does not state things it cannot check should not
                 open by understating its own bill. -->
            <TextBlock x:Name="CostNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Billed to you by Anthropic for every file read: tens of cents for a small application, a few dollars for a large one. The report states what was spent."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Remove key" Style="{StaticResource Btn}" Click="OnRemove"/>
                <!-- IsCancel so Escape still closes it. Replacing the system title bar took
                     away the usual way out of a dialog, and the custom close button is the
                     only other one. -->
                <Button Content="Cancel" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="Save" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnSave" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
